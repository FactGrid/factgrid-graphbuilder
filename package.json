{
	"name": "wikidata-graph-builder",
	"version": "2.0.0",
	"description": "Visualize Wikibase item graphs using d3.js",
	"authors": [
		"AngryLoki",
		"Superraptor"
	],
	"keywords": [
		"wikibase",
		"d3"
	],
	"homepage": "https://angryloki.github.io/wikidata-graph-builder/",
	"bugs": "https://github.com/AngryLoki/wikidata-graph-builder/issues",
	"license": "MIT",
	"licenses": [
		{
			"type": "MIT",
			"url": "https://github.com/AngryLoki/wikidata-graph-builder/blob/master/LICENSE"
		}
	],
	"repository": {
		"type": "git",
		"url": "git://github.com/AngryLoki/wikidata-graph-builder.git"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "xo",
		"deploy": "vite build && npx gh-pages -t -d build"
	},
	"devDependencies": {
		"@floating-ui/dom": "^1.2.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@mdi/js": "^7.1.96",
		"@qix/elkjs-patched": "0.8.0-patch3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-drag": "^3.0.2",
		"@types/d3-scale": "^4.0.3",
		"@types/d3-selection": "^3.0.4",
		"@types/d3-zoom": "^3.0.2",
		"@types/lodash.escape": "^4.0.7",
		"@types/lodash.isequal": "^4.5.6",
		"@types/lodash.throttle": "^4.1.7",
		"bits-ui": "^2.19.0",
		"canvas-color-tracker": "^1.1.6",
		"clsx": "^2.1.1",
		"d3-drag": "^3.0.0",
		"d3-force-3d": "^3.0.3",
		"d3-scale": "^4.0.2",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"lodash.escape": "^4.0.1",
		"lodash.isequal": "^4.5.0",
		"lodash.throttle": "^4.1.1",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.10",
		"svelte-awesome-color-picker": "^4.1.3",
		"svelte-check": "^4.7.6",
		"svelte-floating-ui": "^1.6.2",
		"svelte-intersection-observer": "^2.2.0",
		"svelte-useactions": "^1.0.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.5.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"xo": "^0.59.3"
	},
	"packageManager": "pnpm@9.6.0",
	"engines": {
		"pnpm": ">=9.0.0"
	},
	"type": "module",
	"xo": {
		"rules": {
			"import/extensions": "off",
			"n/file-extension-in-import": "off",
			"@typescript-eslint/no-unsafe-assignment": "off"
		}
	},
	"dependencies": {
		"jspdf": "^4.2.1",
		"svg2pdf.js": "^2.7.0"
	}
}